    <string name="settings_boyue_wheel">스티어링 휠 버튼</string>
    <string name="settings_boyue_wheel_description">지원되는 버튼의 동작을 선택합니다. 차량 블루투스 오디오를 사용하면 중복 명령을 방지하기 위해 미디어 버튼은 차량에서 처리합니다.</string>
    <string name="settings_boyue_none">동작 없음</string>
    <string name="settings_boyue_play">재생 / 일시 정지</string>
    <string name="settings_boyue_next">다음 곡</string>
    <string name="settings_boyue_previous">이전 곡</string>
